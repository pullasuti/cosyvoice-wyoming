# Copy to .env to override run.sh defaults. All values are optional.

# Reference voice to clone (10-20 s clean mono WAV) and the name HA shows.
PROMPT_WAV=voices/nicoleheart.wav
VOICE=nicoleheart

# Mood for text before any mood tag (e.g. warm, confident). Empty disables,
# which sends untagged text through CosyVoice's plain cross-lingual mode.
DEFAULT_MOOD=warm

# Wyoming listen address.
URI=tcp://0.0.0.0:10214

# Model
MODEL_ID=FunAudioLLM/Fun-CosyVoice3-0.5B-2512
MODEL_DIR=CosyVoice/pretrained_models/Fun-CosyVoice3-0.5B

# 1 = on, 0 = off. TRT builds a TensorRT engine on first start (several minutes).
USE_RL=1
FP16=1
TRT=1

# Streaming: audio held before playback starts, and how much speech to merge
# per model call after the first sentence.
PREBUFFER_SECONDS=1
MIN_MERGED_SECONDS=2.5
